{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BenjisCollector/open-farm/main/schema/scene.v0.schema.json",
  "title": "Open Farm Scene v0",
  "description": "The contract between the agent (writes) and the viewer (renders). The agent edits scene state only; numbers in flows come from the engine and must cite a source.",
  "type": "object",
  "required": [
    "version",
    "clock",
    "entities",
    "flows"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "description": "Every user-facing string is bilingual.",
      "type": "object",
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": {
      "const": "0"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "location": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": [
        "day"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 0,
          "description": "Simulation day; 0 = hatch / planting."
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "Sim days per real second in the viewer."
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "pos"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "house",
              "plot",
              "pen",
              "pond",
              "storage",
              "coop",
              "rack",
              "tank",
              "panel",
              "crop",
              "hen",
              "cow",
              "goat",
              "sheep",
              "compost"
            ]
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "props": {
            "type": "object",
            "description": "Optional. rect: [x, y, w, h] in map tiles makes the entity a map zone. zone: id of the zone an animal group lives in. count: number of animals. crop: tomato | corn | vegetables | lettuce for plots. area_m2: plot area, which engine/build.py needs to compute crop flows.",
            "properties": {
              "rect": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "zone": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "crop": {
                "type": "string"
              },
              "area_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "description": "What goes in and comes out of an entity. Rendered as live counters.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "direction",
          "resource",
          "unit",
          "per_day",
          "source"
        ],
        "properties": {
          "entity": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "resource": {
            "$ref": "#/$defs/text"
          },
          "unit": {
            "type": "string"
          },
          "per_day": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Low and high per_day from the cited range. per_day is the midpoint."
          },
          "trust": {
            "enum": [
              "web",
              "ai_report"
            ],
            "description": "web = cited external page; ai_report = only NotebookLM's own summary, re-verify."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "weather": {
      "type": "object",
      "description": "Current conditions shown on the Weather screen. Needs a source like any number.",
      "required": [
        "condition",
        "temp_c",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "sunny",
            "cloudy",
            "windy",
            "rain",
            "rainbow"
          ]
        },
        "temp_c": {
          "type": "number"
        },
        "feels_c": {
          "type": "number"
        },
        "humidity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dew_c": {
          "type": "number"
        },
        "wind_kmh": {
          "type": "number",
          "minimum": 0
        },
        "rain_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "live": {
          "type": "boolean",
          "description": "true only when values come from a live data feed. The viewer hides the Weather screen otherwise."
        }
      }
    },
    "stocks": {
      "type": "array",
      "description": "Things the farm stores. level, capacity and refill_per_day are the user's settings, not sourced facts.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "unit": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "minimum": 0
          },
          "capacity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "refill_per_day": {
            "type": "number",
            "minimum": 0,
            "description": "Daily supply from outside the farm (well pump, feed delivery)."
          },
          "supply": {
            "$ref": "#/$defs/text"
          },
          "zone": {
            "type": "string",
            "description": "Map zone that holds this stock."
          },
          "convert": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Share of each routed output kept when it enters (e.g. manure that remains as compost)."
          },
          "convert_source": {
            "type": "string"
          },
          "convert_range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "convert_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "Connect flows to stocks by resource name. An entity-specific route beats a general one.",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "direction",
          "stock"
        ],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string",
            "description": "Matches flow.resource.en"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "stock": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          }
        }
      }
    },
    "survival": {
      "type": "array",
      "description": "How long a part survives without an input before it dies. Written by engine/build.py from data/survival.json; every limit needs a source.",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "resource",
          "days",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "description": "Matches flow.resource.en of an input"
          },
          "days": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              },
              "additionalProperties": false
            }
          },
          "basis": {
            "enum": [
              "lethal",
              "observed",
              "derived"
            ],
            "description": "lethal = published mortality figure; observed = longest survival seen in studies; derived = worked out from published data"
          }
        }
      }
    }
  }
}
